# Copy to .env.local for local development with Neon.
# Neon Console > Connect > enable Connection pooling > copy the PostgreSQL URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Generate once; use the same private value locally and on Vercel.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SPINVAULT_SESSION_SECRET=

BYTEFX_API_BASE_URL=https://my.bytefx.com/api/
APP_ORIGIN=http://localhost:3000
# On Vercel set APP_ORIGIN=https://bytefx-spinvalut.vercel.app

# Local SQLite fallback only when DATABASE_URL is empty; ignored when using Neon.
SPINVAULT_DATA_DIR=.data
